{
  "name": "boundstoy",
  "version": "0.4.2",
  "private": true,
  "description": "A static, headless-first browser playground for ice sliding and bounds.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4321",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-check.ts",
    "test:journey": "npm run build && node tests/browser/journey.ts",
    "test:explosions": "npm run build && node tests/browser/explosions.ts",
    "release:check": "npm run evaluate && node scripts/browser-check.ts && node tests/browser/journey.ts && node tests/browser/explosions.ts && node tests/mobile-readability.test.ts --readability-browser",
    "test:readability": "npm run build && node tests/mobile-readability.test.ts --readability-browser",
    "test:astro": "npm run build && node scripts/check-astro.ts",
    "test:watch": "node --test --watch tests/*.test.ts",
    "inspect": "node scripts/inspect.ts",
    "tasks": "node scripts/tasks.ts",
    "tasks:check": "node scripts/tasks.ts check",
    "evaluate": "npm run tasks:check && npm test && npm run build"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
